<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8B5CF6;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background rounded square -->
  <rect x="10" y="10" width="80" height="80" rx="16" fill="url(#logoGradient)"/>
  
  <!-- Document/page icon -->
  <rect x="30" y="25" width="40" height="50" rx="4" fill="white" fill-opacity="0.95"/>
  
  <!-- Markdown lines -->
  <rect x="35" y="32" width="20" height="3" rx="1.5" fill="#3B82F6"/>
  <rect x="35" y="40" width="30" height="2" rx="1" fill="#6B7280"/>
  <rect x="35" y="47" width="25" height="2" rx="1" fill="#6B7280"/>
  <rect x="35" y="54" width="28" height="2" rx="1" fill="#6B7280"/>
  
  <!-- M and K letters -->
  <text x="50" y="72" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="700" fill="#3B82F6" text-anchor="middle">MK</text>
</svg>
